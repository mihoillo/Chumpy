<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Watching the network under the tunnel, v2rayNG's way: the physical default
         network is asked for by request (CHANGE_NETWORK_STATE, a normal permission
         granted at install), and its changes hand the core over to a re-dial. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- The short haptic pokes on the settings buttons go through the Vibrator directly. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The VPN runs as a specialUse foreground service (as v2rayNG does). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The QR scanner's own; asked for only there, on first scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The trusted networks read the current Wi-Fi's name; Android shares names with
         location access only (and with the Wi-Fi state visible at all). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Package visibility (Android 11+): without declaring what we look for, the
         per-app proxy's launcher query only answers with a handful of system packages.
         The MAIN/LAUNCHER intent filter is the app picker's own scope — every app the
         launcher can start. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AuroraApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Aurora"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- The MAIN/LAUNCHER intent-filter lives on the aliases below: switching the
                 icon variant flips which alias is enabled, and the launcher follows. -->
            <!-- Long-pressing the Quick Settings tile opens the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- The three launcher entries, one per icon variant. Exactly one is enabled at a
             time (Aurora out of the box); the settings screen flips them via
             PackageManager.setComponentEnabledSetting, and the picker applies the choice
             the moment it is made. -->
        <activity-alias
            android:name=".LauncherAurora"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The inverted icon: white art on the sky background. -->
        <activity-alias
            android:name=".LauncherInverted"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_inverted"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The themed icon: neutral art the system's own themed icons (Android 13+) can
             tint with the monet palette; in the app's own colors everywhere else. -->
        <activity-alias
            android:name=".LauncherThemed"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_themed"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            The wallpaper picker, a one-off deep dive from the interface settings rather
            than a navbar destination: two pages (preview, settings) under one bar. Back
            (gesture or button) simply finishes it.
        -->
        <activity
            android:name=".ui.wallpapers.WallpaperActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.perapp.PerAppProxyActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <!--
            The QR scanner: a full-screen camera that returns one decoded string. A
            separate activity rather than a navbar destination: it needs the camera
            permission and a result channel, and back (gesture or tile) simply exits.
        -->
        <activity
            android:name=".ui.scan.ScannerActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
            Everything that has to outlive the UI lives in ":core": this VpnService with
            the Xray runtime and the QS tile. The UI process talks to it over AIDL and can
            be killed at any time. The system itself binds it for Always-on VPN.
        -->
        <service
            android:name=".core.AuroraVpnService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:process=":core"
            tools:ignore="VpnServicePolicy">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!--
            Same ":core" process as the core, so the tile keeps toggling the VPN while
            the UI process is not running. Clicking without a config or VPN consent just
            opens the app.
        -->
        <service
            android:name=".core.QuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_off"
            android:label="@string/app_name"
            android:process=":core"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
